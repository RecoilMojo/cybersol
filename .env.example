# Public site
NEXT_PUBLIC_SITE_URL=https://cybersol.org
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Client wallet adapter only — do NOT put HELIUS_API_KEY in this URL (it would leak to the browser).
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_TOKEN_MINT=
# Paste these at launch — homepage chips stay TBA until set
NEXT_PUBLIC_BUY_URL=
NEXT_PUBLIC_PUMP_URL=
NEXT_PUBLIC_DEX_URL=
NEXT_PUBLIC_HOLD_THRESHOLD=10000
NEXT_PUBLIC_DEV_WALLET=
NEXT_PUBLIC_REWARDS_WALLET=

# Server (hold checks + raffle RPC). Never expose this key to NEXT_PUBLIC_*.
HELIUS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional anon key if you add client-side reads later
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local memory store when Supabase is unset (dev only)
USE_MEMORY_STORE=true

# Daily raffle (NEVER commit real key; local / CI secret only).
# This must be the raffle wallet — not the living wallet or the dev bag.
REWARDS_KEYPAIR_BASE58=
RAFFLE_POOL_SOL=0.5
RAFFLE_WINNERS=3
MAX_TICKETS_PER_DAY=3
